# Copie para .env (que não é versionado) e preencha.

# Token de leitura da API da TMDB (v4 "API Read Access Token").
# Gere em https://www.themoviedb.org/settings/api
VITE_TMDB_TOKEN=

# true = usa uma TMDB simulada (MSW) com um catálogo de demonstração, sem token.
# Na busca, o termo "erro429" simula o limite de requisições.
VITE_TMDB_MOCK=false

# Repositório local que simula o back-end dos dados do usuário.
# Atraso aleatório de cada operação, em milissegundos.
VITE_USER_DATA_MIN_DELAY_MS=300
VITE_USER_DATA_MAX_DELAY_MS=1500
# Escritas em filmes cujo id termina com este sufixo falham. Vazio desliga.
VITE_USER_DATA_FAIL_SUFFIX=13

# URLs dos remotes vistas pelo Shell (opcional; padrão: localhost:3001–3003).
# VITE_REMOTE_CATALOGO_URL=http://localhost:3001/remoteEntry.js
# VITE_REMOTE_FILME_URL=http://localhost:3002/remoteEntry.js
# VITE_REMOTE_MINHA_AREA_URL=http://localhost:3003/remoteEntry.js
